FROM jenkins/jenkins:lts-jdk21
USER root
RUN apt-get update && apt-get install -y docker.io curl && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/jdk26 && \
    ARCH=$(dpkg --print-architecture | sed 's/amd64/x64/;s/arm64/aarch64/') && \
    curl -fsSL "https://api.adoptium.net/v3/binary/latest/26/ga/linux/${ARCH}/jdk/hotspot/normal/eclipse" | tar -xz -C /opt/jdk26 --strip-components=1
RUN curl -fsSL https://archive.apache.org/dist/maven/maven-3/3.9.11/binaries/apache-maven-3.9.11-bin.tar.gz | tar -xz -C /opt && ln -s /opt/apache-maven-3.9.11 /opt/maven